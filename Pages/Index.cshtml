@page
@model IndexModel

@{
    ViewData["Title"] = "Главная";
}

<div class="form-container shadow main bg-dark">

    <p class="font-monospace ">COLLEGEJOB</p>
    <h2 class="text-white">
        <strong>Твой следующий шаг в карьере</strong>
    </h2>
    <p class="description">
        Публикуй резюме, расскажи о своих навыках и получи возможности для профессионального роста
    </p>

    <a class="btn btn-light hover-lift py-2 px-3 text-decoration-none mb-2" data-text="Смотреть резюме" asp-area="" asp-page="/Resume">Смотреть резюме</a>
    <a class="btn btn-outline-light hover-lift py-2 px-3 text-decoration-none mb-2" data-text="Создать резюме" asp-area="" asp-page="/NewResume">Создать резюме</a>
    

</div>

<div class="container mb-4">
  <div class="row g-4 justify-content-center">
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow h-100 p-2">
        <div class="card-body">
          <h5 class="card-title">Создай резюме</h5>
          <p class="card-text">Расскажи о себе, специальности и технологиях, которыми владеешь.</p>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow h-100 p-2">
        <div class="card-body">
          <h5 class="card-title">Изучи кандидатов</h5>
          <p class="card-text">Просматривай анкеты и найди специалиста с нужным навыком.</p>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow h-100 p-2">
        <div class="card-body">
          <h5 class="card-title">Развивайся</h5>
          <p class="card-text">Используй платформу как первый шаг к поиску стажировки или работы.</p>
        </div>
      </div>
    </div>
  </div>
</div>

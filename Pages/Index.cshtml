@page
@model IndexModel

@{
    ViewData["Title"] = "Главная";
}

<div class="form-container">

    <h1>Анкета студента</h1>

    <p class="description">
        Введите свои данные
    </p>

    <form id="student-form" method="post">

        <div class="form-group">
            <label>Имя-фамилия:</label>
            <input type="text" name="InputStudent.Name" placeholder="Введите имя" required>
        </div>

        <div class="form-group">
            <label>Номер телефона:</label>
            <input type="tel" name="InputStudent.Phone" placeholder="+7 (___) ___-__-__" required id="phone-input">
        </div>

        <div class="form-group">
            <label>Email:</label>
            <input type="email" name="InputStudent.Email" placeholder="email@example.com" required>
        </div>

        <div class="form-group">
            <label>Специальность:</label>
            <div class="speciality">
                <input type="radio" name="InputStudent.Speciality" value="Программирование" id="dev" required>
                <label for="dev">Программирование</label>
                <br>
                <input type="radio" name="InputStudent.Speciality" value="Дизайн" id="design">
                <label for="design">Дизайн</label>
                <br>
                <input type="radio" name="InputStudent.Speciality" value="Маркетинг" id="marketing">
                <label for="marketing">Маркетинг</label>
            </div>
        </div>

        <div class="form-group">
            <label for="courses">Курс:</label>
            <select name="InputStudent.Course" id="courses" required>
                <option value="" disabled selected>Выберите курс</option>
                <option value="1 курс">1 курс</option>
                <option value="2 курс">2 курс</option>
                <option value="3 курс">3 курс</option>
                <option value="4 курс">4 курс</option>
            </select>
        </div>

        <div class="form-group">
            <label for="">Дата рождения:</label>
            <input type="date" name="InputStudent.BirthDate" required>
        </div>

        <div class="form-group">
            <label for="">Технологии:</label>
            <div class="speciality">
                <input type="checkbox" name="InputStudent.Technologies" value="HTML/CSS" id="html">
                <label for="html">HTML/CSS</label>
                <br>
                <input type="checkbox" name="InputStudent.Technologies" value="JavaScript" id="js">
                <label for="js">JavaScript</label>
                <br>
                <input type="checkbox" name="InputStudent.Technologies" value="C#" id="csharp">
                <label for="csharp">C#</label>
                <br>
                <input type="checkbox" name="InputStudent.Technologies" value="Python" id="python">
                <label for="python">Python</label>
            </div>
        </div>

        <button class="form-button" type="submit">
            Отправить
        </button>
        <br><br>
        <button class="form-button-clear" type="reset">
            Очистить
        </button>

    </form>

    <div id="result-container" class="result" style="display: none;">
        <h3>Результат обработки анкеты:</h3>
        <div id="pretty-card" class="person-card" style="display: none;">
            <img class="person-card__photo" src="~/images/943474a189e25a78e83fe3d2ae9b656e.jpg" alt="Фото профиля">
            <div class="person-card__info">
                <h3 id="card-name" class="person-card__type"></h3>
                <p id="card-speciality" class="person-card__content"></p>
                <p class="person-card__content"><strong>Тел:</strong> <span id="card-phone"></span></p>
                <p class="person-card__content"><strong>Email:</strong> <span id="card-email"></span></p>
                <p class="person-card__content"><strong>Технологии:</strong> <span id="card-techs"></span></p>
            </div>
        </div>
    </div>

</div>

<script>
    const resultContainer = document.getElementById("result-container");
    const form = document.getElementById("student-form");
    const prettyCard = document.getElementById("pretty-card");

    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const button = form.querySelector("button");
        const originalButtonText = button.textContent;
        button.textContent = "Отправка...";
        button.disabled = true;

        try {
            const formData = new FormData(form);

            const response = await fetch("", {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                throw new Error(`${response.status}`);
            }

            const data = await response.json();

            console.log("Полученные данные:", data);

            resultContainer.style.display = "block";

            if (data.success && data.data) {
                document.getElementById("card-name").textContent = data.data.name;
                document.getElementById("card-speciality").textContent = `${data.data.speciality}, ${data.data.course}`;
                document.getElementById("card-phone").textContent = data.data.phone;
                document.getElementById("card-email").textContent = data.data.email;
                document.getElementById("card-techs").textContent = data.data.technologies;

                prettyCard.style.display = "flex";
            } else {
                prettyCard.style.display = "none";
            }

            button.textContent = "Анкета успешно отправлена (❁´◡`❁)";
            button.style.backgroundColor = "#4CAF50";

            setTimeout(() => {
                button.textContent = originalButtonText;
                button.style.backgroundColor = "";
                button.disabled = false;
            }, 2000);

        } catch (error) {
            console.error("Ошибка:", error);
            button.textContent = originalButtonText;
            button.disabled = false;
        }
    });

    form.addEventListener("reset", async function (event) {
        resultContainer.style.display = "none";
    });
</script>


<script>
    const phoneInput = document.getElementById('phone-input');

    phoneInput.addEventListener('input', function (e) {
        let x = e.target.value.replace(/\D/g, '');

        if (x.length > 0 && x[0] === '8') {
            x = '7' + x.substring(1);
        }

        let formatted = '';
        if (x.length > 0) {
            formatted = '+7';
            if (x.length > 1) formatted += ' (' + x.substring(1, 4);
            if (x.length >= 4) formatted += ') ' + x.substring(4, 7);
            if (x.length >= 7) formatted += '-' + x.substring(7, 9);
            if (x.length >= 9) formatted += '-' + x.substring(9, 11);
        }

        e.target.value = formatted;
    });

    phoneInput.addEventListener('keydown', function (e) {
        if ((e.key === 'Backspace' || e.key === 'Delete') && this.value.length <= 2) {
            e.preventDefault();
        }
        if (e.key === 'Backspace' || e.key === 'Delete') {
            this.value = this.value.replace(/[-()\s]+$/, "");
        }
    });

    phoneInput.addEventListener('blur', function () {
        const digits = this.value.replace(/\D/g, '').length;
        if (digits < 11 && digits > 0) {
            this.value = '';
        }
    });
</script>
@page
@model ResumeModel

@{
    ViewData["Title"] = "Анкеты";
}

<div class="form-container shadow main">
    <div class="position-relative mb-4">
        <p class="font-monospace text-dark small text-uppercase">CollegeJob</p>
        <a class="position-absolute top-0 end-0 btn btn-outline-dark hover-lift py-2 px-3 text-decoration-none text-dark mb-2" data-text="Создать резюме" asp-area="" asp-page="/NewResume">Создать резюме</a>
    </div>

    <div id="result-container"></div>
</div>

<template id="student-template">

    <div class="card person-card shadow position-relative rounded hover-lift">
        <div class="card-body">
            <span class="card-id shadow-sm position-absolute top-0 start-0 m-2 border rounded"></span>

            <button class="form-button-clear shadow-sm position-absolute top-0 end-0 m-2 border rounded" type="button" aria-label="Удалить">
                X
            </button>
            <div class="d-flex align-items-center gap-3 mb-4">
                <img class="person-card__photo" src="~/images/943474a189e25a78e83fe3d2ae9b656e.jpg" alt="avatar">

                <div class="min-w-0">
                    <h5 class="card-name text-truncate mb-1"></h5>
                    <div class="card-speciality text-secondary text-truncate"></div>
                </div>
            </div>
            <div class="d-grid gap-3">
                <div>
                    <div class="person-card-label text-uppercase">Phone</div>
                    <div class="person-card-value">
                        <span class="card-phone"></span>
                    </div>
                </div>
                <div>
                    <div class="person-card-label text-uppercase">Email</div>
                    <div class="person-card-value">
                        <span class="card-email"></span>
                    </div>
                </div>
                <div>
                    <div class="person-card-label text-uppercase">Technologies</div>
                    <div class="person-card-value">
                        <span class="d-flex card-techs gap-2"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<script>

   async function deleteUser(id, cardElement) {
    try {
        const response = await fetch(`?handler=Delete&id=${id}`, {
            method: "POST"
        });

        if (!response.ok) throw new Error(`Ошибка сервера: ${response.status}`);

        const result = await response.json();
        if (result.success) {
            cardElement.remove();
        }
    } catch (error) {
        console.error("Ошибка при удалении:", error);
    }
}

</script>

<script>
    const resultContainer = document.getElementById("result-container");
    const template = document.getElementById("student-template");

    document.addEventListener("DOMContentLoaded", async function () {
        try {
            const response = await fetch("?handler=All", { method: "GET" });
            if (!response.ok) throw new Error(`Ошибка сервера: ${response.status}`);
            const result = await response.json();

            if (result.success && result.data && result.data.length > 0) {

                result.data.forEach(student => {
                    const clone = template.content.cloneNode(true);
                    const card = clone.querySelector(".person-card");

                    clone.querySelector(".card-id").textContent = `${student.id}`;
                    clone.querySelector(".card-name").textContent = student.name;
                    clone.querySelector(".card-speciality").textContent = `${student.speciality}, ${student.course}`;
                    clone.querySelector(".card-phone").textContent = student.phone;
                    clone.querySelector(".card-email").textContent = student.email;

                    const techContainer = clone.querySelector(".card-techs");

                    techContainer.replaceChildren();

                    if (Array.isArray(student.technologies) && student.technologies.length > 0) {
                        student.technologies.forEach((tech) => {
                            const badge = document.createElement("span");

                            badge.classList.add("badge", "text-bg-primary");
                            badge.textContent = tech;

                            techContainer.appendChild(badge);
                        });
                    } else {
                        const badge = document.createElement("span");
                        badge.classList.add("badge", "text-bg-danger");
                        badge.textContent = "Немае";
                        techContainer.appendChild(badge);
                    }

                    clone.querySelector(".form-button-clear")
                        .addEventListener("click", () => deleteUser(student.id, card));

                    resultContainer.appendChild(clone);
                });
            } else {
                resultContainer.innerHTML = "<p>Нет доступных резюме</p>";
            }
        } catch (error) {
            console.error("Ошибка при загрузке:", error);
        }
    });
</script>
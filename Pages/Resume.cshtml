@page
@model ResumeModel

@{
    ViewData["Title"] = "Анкеты";
}

<div class="form-container anketa">
    <h1>Анкеты студентов</h1>

    <div id="result-container">
    </div>
</div>

<template id="student-template">
    <div class="person-card" style="display: flex; margin-bottom: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 8px; background: #f9f9f9;">
        <img class="person-card__photo" src="~/images/943474a189e25a78e83fe3d2ae9b656e.jpg" alt="Фото" style="width: 60px; height: 60px;">
        <div class="person-card__info">
            <div style="display: flex;"><h3 class="card-name" style="margin: 0 0 5px 0; color: #333;"></h3>&nbsp;<h3 class="card-id" style="margin: 0 0 5px 0; color: #333;"></h3></div>
            <p class="card-speciality" style="margin: 0 0 10px 0; color: #666; font-style: italic;"></p>
            <p style="margin: 4px 0;"><strong>Тел:</strong> <span class="card-phone"></span></p>
            <p style="margin: 4px 0;"><strong>Email:</strong> <span class="card-email"></span></p>
            <p style="margin: 4px 0;"><strong>Технологии:</strong> <span class="card-techs"></span></p>
        </div>
        <button class="form-button-clear" type="button">X</button>

    </div>
</template>

<script>

   async function deleteUser(id, cardElement) {
    try {
        const response = await fetch(`?handler=Delete&id=${id}`, {
            method: "POST"
        });

        if (!response.ok) throw new Error(`Ошибка сервера: ${response.status}`);

        const result = await response.json();
        if (result.success) {
            cardElement.remove();
        }
    } catch (error) {
        console.error("Ошибка при удалении:", error);
    }
}

</script>

<script>
    const resultContainer = document.getElementById("result-container");
    const template = document.getElementById("student-template");

    document.addEventListener("DOMContentLoaded", async function () {
        try {
            const response = await fetch("?handler=All", { method: "GET" });
            if (!response.ok) throw new Error(`Ошибка сервера: ${response.status}`);
            const result = await response.json();

            if (result.success && result.data && result.data.length > 0) {

                result.data.forEach(student => {
                    const clone = template.content.cloneNode(true);
                    const card = clone.querySelector(".person-card");

                    clone.querySelector(".card-id").textContent = `| ID: ${student.id}`;
                    clone.querySelector(".card-name").textContent = student.name;
                    clone.querySelector(".card-speciality").textContent = `${student.speciality}, ${student.course}`;
                    clone.querySelector(".card-phone").textContent = student.phone;
                    clone.querySelector(".card-email").textContent = student.email;

                    const techs = Array.isArray(student.technologies)
                        ? student.technologies.join(", ")
                        : student.technologies;
                    clone.querySelector(".card-techs").textContent = techs ? techs : "Немае";

                    clone.querySelector(".form-button-clear")
                        .addEventListener("click", () => deleteUser(student.id, card));

                    resultContainer.appendChild(clone);
                });
            } else {
                resultContainer.innerHTML = "<p>Студенты не найдены.</p>";
            }
        } catch (error) {
            console.error("Ошибка при загрузке:", error);
        }
    });
</script>
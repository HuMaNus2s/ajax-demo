<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/aspnetWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <header class="bg-light">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><span class="text-dark fw-medium font-monospace">College</span><strong class="font-monospace text-purple-700">Job</strong></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-2">
                        <li class="nav-item">
                            <a class="nav-link hover-lift text-decoration-none" data-text="Главная" asp-area="" asp-page="/Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link hover-lift text-decoration-none" data-text="Написать резюме" asp-area="" asp-page="/NewResume">Написать резюме</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link hover-lift text-decoration-none" data-text="Резюме" asp-area="" asp-page="/Resume">Резюме</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link hover-lift text-decoration-none" data-text="О проекте" asp-area="" asp-page="/About">О проекте</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="bg-body container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - CollegeJob - <a asp-area="" asp-page="/About">О проекте</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
